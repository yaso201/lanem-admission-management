---
/* NOTES-CONCOURS — saisie des notes de concours (Prépa). Le front est un PUR RENDERER : plage,
   moyenne, signal éliminatoire et coefficients viennent du back (source unique exam_grading).
   « Le système signale, le Responsable décide » — aucune décision calculée ici.
   Données : admission.api.staff.{list_prepa_sessions, list_notes_roster, set_exam_coefficients,
   saisir_notes_masse, export_notes_template, import_notes_preview, valider_notes_concours}. */
import Layout from '../layouts/Layout.astro';
---
<Layout title="Saisie des notes — emela management" role="admin" page="notes" shared={true}>
<main class="page" id="main-content">
  <div class="page-head">
    <div>
      <h1 class="page-title">Saisie des notes de concours</h1>
      <p class="page-sub" id="sub">Choisissez une session à concours.</p>
    </div>
    <div style="display:flex;gap:var(--space-3)">
      <button type="button" class="em-btn em-btn--secondary em-btn--sm" id="btn-export" hidden><svg class="ico-sm"><use href="#i-file"/></svg>Exporter (CSV)</button>
      <label class="em-btn em-btn--secondary em-btn--sm" id="btn-import-l" hidden style="cursor:pointer;margin:0"><svg class="ico-sm"><use href="#i-tray"/></svg>Importer un fichier<input type="file" id="file-import" accept=".csv,text/csv" hidden></label>
    </div>
  </div>

  <div class="nt-field">
    <label class="nt-lbl" for="sess">Session</label>
    <select class="nt-sel" id="sess"><option value="">— choisir une session —</option></select>
  </div>

  <section class="card" id="coef-card" hidden>
    <div class="card-head">
      <div><div class="card-title">Coefficients des épreuves</div><div class="card-sub">Identiques pour tous les candidats de la session.</div></div>
      <span class="em-badge em-badge--neutral em-badge--sm" id="coef-state"></span>
    </div>
    <div class="card-body">
      <p class="nt-help" id="coef-help"></p>
      <div id="coef-fields" class="nt-coef"></div>
    </div>
  </section>

  <div class="em-alert em-alert--neutral" id="signal-note" hidden>
    <span class="em-alert-icon"><svg class="ico"><use href="#i-eye"/></svg></span>
    <div class="em-alert-body"><span class="em-alert-text"><b>La moyenne et le signal « éliminatoire » sont indicatifs.</b> Une note strictement inférieure à 6 sur une épreuve est signalée, épreuve par épreuve — <b>la décision revient au Responsable</b> (aucune élimination automatique).</span></div>
  </div>

  <div id="imp-host"></div>
  <div id="roster"></div>
  <!-- C8 (FIX-3) : historique des modifications — lecture seule, journal serveur (DEC-J) -->
  <div class="card" id="hist-card" hidden style="margin-top:var(--space-6)">
    <div class="card-head"><div class="card-title">Historique des modifications</div>
      <div style="display:flex;gap:var(--space-3);align-items:center">
        <label class="nt-lbl" for="hist-flt" style="margin:0">Candidat</label>
        <select class="nt-sel" id="hist-flt" style="width:auto;min-width:200px"><option value="">Tous</option></select>
        <button type="button" class="em-btn em-btn--ghost em-btn--sm" id="hist-refresh">Actualiser</button>
      </div></div>
    <div class="card-body" id="hist-body"></div>
  </div>
  <div id="nt-errors"></div>
  <div id="save-result"></div>

  <div class="savebar" id="savebar" hidden>
    <span class="nt-help" id="save-info">Saisissez les 3 notes /20 ou cochez « absent ». Cette case est un signal uniquement : elle ne place jamais le dossier en ABS ; le Responsable décide dossier par dossier.</span>
    <div style="display:flex;gap:var(--space-3)">
      <button type="button" class="em-btn em-btn--secondary" id="btn-validate" hidden><svg class="ico-sm"><use href="#i-gavel"/></svg>Valider la session…</button>
      <button type="button" class="em-btn em-btn--primary" id="btn-save"><svg class="ico-sm"><use href="#i-check"/></svg>Enregistrer les notes</button>
    </div>
  </div>
</main>

<style>
  .nt-field{max-width:520px;margin-bottom:var(--space-6)}
  .nt-lbl,.nt-help{display:block;font-size:var(--text-xs);color:var(--text-secondary)}
  .nt-lbl{margin-bottom:6px;font-weight:600}
  .nt-help{margin:0 0 var(--space-3)}
  .nt-sel,.nt-in{font:inherit;padding:9px 11px;border:1px solid var(--border,#d9d9d9);border-radius:9px;background:var(--surface-paper,#fff);color:var(--text-primary,#171717)}
  .nt-sel{width:100%}
  .nt-in{width:70px;text-align:center}
  /* A11 : pas de flèches (le correcteur frappe, il n'incrémente pas) — clavier numérique conservé */
  .nt-in::-webkit-outer-spin-button,.nt-in::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
  .nt-in{-moz-appearance:textfield;appearance:textfield}
  .nt-in:focus,.nt-sel:focus{outline:2px solid var(--accent,#2b6cb0);outline-offset:1px;border-color:transparent}
  .nt-in.nt-invalid{border-color:#c0392b;background:#fff5f5}
  .nt-in.nt-invalid:focus{outline-color:#c0392b}
  #btn-save:disabled{opacity:.45;cursor:not-allowed;pointer-events:none}
  .nt-coef{display:flex;gap:var(--space-4);flex-wrap:wrap;align-items:flex-end}
  .nt-coef .cf{display:flex;flex-direction:column;gap:6px}
  .card-head{display:flex;justify-content:space-between;align-items:flex-start;gap:var(--space-4)}
  .nt-moy{font-weight:700}
  .nt-row.is-abs .nt-in{opacity:.35;pointer-events:none}
  .imp-probs{margin:var(--space-3) 0 0;padding-left:1.1em;color:var(--text-secondary);font-size:var(--text-sm);max-height:220px;overflow:auto}
  .imp-probs li{margin:2px 0}
  .savebar{position:sticky;bottom:0;margin-top:var(--space-6);background:var(--surface-paper,#fff);border-top:1px solid var(--border-subtle,#eee);padding:14px 2px;display:flex;justify-content:space-between;align-items:center;gap:var(--space-4)}
  .nt-abs{display:inline-flex;align-items:center;gap:6px;color:var(--text-secondary);font-size:var(--text-sm)}
</style>

<script is:inline>
(function(){
  const API = window.EmelaAPI, UI = window.EmelaUI, esc = UI.esc;
  let SUBJECTS = [], SESSION = null, DATA = null, CANSETCOEF = false, CANVALIDATE = false, COEF_EDITING = false;
  const $ = id => document.getElementById(id);
  const coefSet = () => !!(DATA && DATA.coefficients_set);

  function moyCell(c){
    if(c.absent) return '<span class="em-badge em-badge--neutral em-badge--sm">Absent(e)</span>';
    if(c.moyenne == null) return '<span style="color:var(--text-secondary)">—</span>';
    let h = '<span class="nt-moy">' + esc(String(c.moyenne)) + '</span>';
    if((c.eliminatoire||[]).length){
      const labs = c.eliminatoire.map(k => (SUBJECTS.find(s => s.key===k)||{}).label || k).join(', ');
      h += ' <span class="em-badge em-badge--warning em-badge--sm" title="Signal — le Responsable décide">éliminatoire : ' + esc(labs) + '</span>';
    }
    return h;
  }

  function renderCoef(){
    const coefs = DATA.coefficients || {}, isSet = !!DATA.coefficients_set, frozen = !!DATA.coefficients_frozen;
    $('coef-card').hidden = false;
    // Machine à états (A09) : jamais posé → saisissable · posé sans note → lecture + Modifier ·
    // modification demandée → rouvert + confirmation · une note → figé définitivement.
    const editable = CANSETCOEF && !frozen && (!isSet || COEF_EDITING);
    const st = $('coef-state');
    st.textContent = frozen ? 'verrouillés' : (isSet ? 'posés' : 'à poser');
    st.className = 'em-badge em-badge--' + (frozen ? 'neutral' : (isSet ? 'success' : 'warning')) + ' em-badge--sm';
    $('coef-help').textContent = frozen
      ? 'Une note a déjà été saisie : la pondération est figée définitivement (la modifier recalculerait la moyenne de tous les candidats).'
      : (!CANSETCOEF ? 'La pondération est définie par le Responsable.'
         : (isSet ? (COEF_EDITING ? 'Modifiez la pondération, puis confirmez.'
                                  : 'Pondération posée. « Modifier » pour la changer (tant qu\'aucune note n\'est saisie).')
                  : 'Posez la pondération de chaque épreuve avant de saisir les notes.'));
    let h = SUBJECTS.map(s => '<div class="cf"><label class="nt-lbl">' + esc(s.label) + '</label>' +
      '<input class="nt-in coef-in" data-k="' + esc(s.key) + '" type="number" min="0.5" step="0.5" value="' +
      (coefs[s.key] != null ? esc(String(coefs[s.key])) : '') + '"' + (editable ? '' : ' disabled') + '></div>').join('');
    if(editable){
      h += '<button type="button" class="em-btn em-btn--primary em-btn--sm" id="coef-save">Enregistrer les coefficients</button>';
      if(isSet) h += '<button type="button" class="em-btn em-btn--ghost em-btn--sm" id="coef-cancel">Annuler</button>';
    } else if(CANSETCOEF && isSet && !frozen){
      h += '<button type="button" class="em-btn em-btn--secondary em-btn--sm" id="coef-modify"><svg class="ico-sm"><use href="#i-pencil"/></svg>Modifier</button>';
    }
    $('coef-fields').innerHTML = h;
    if($('coef-save')) $('coef-save').addEventListener('click', saveCoef);
    if($('coef-modify')) $('coef-modify').addEventListener('click', () => { COEF_EDITING = true; renderCoef(); });
    if($('coef-cancel')) $('coef-cancel').addEventListener('click', () => { COEF_EDITING = false; renderCoef(); });
    $('signal-note').hidden = !isSet;
  }

  async function doSaveCoef(){
    const coefs = {};
    $('coef-fields').querySelectorAll('.coef-in').forEach(inp => { coefs[inp.dataset.k] = inp.value; });
    await API.notesSetCoefficients(SESSION, coefs);
    COEF_EDITING = false;
    UI.emToast('Coefficients enregistrés.', 'success');
    await load(SESSION);
  }

  function saveCoef(){
    if(DATA.coefficients_set){   // A09 : modifier une pondération EXISTANTE = acte explicite (confirmation)
      UI.emModal({
        title: 'Modifier la pondération',
        lead: 'Modifier la pondération recalculera la moyenne de tous les candidats de cette session. Confirmez-vous ?',
        fields: [], submitLabel: 'Modifier et enregistrer',
        onSubmit: async () => { await doSaveCoef(); }
      });
    } else {
      doSaveCoef().catch(e => UI.emToast(e.message, 'error'));   // 1ʳᵉ pose : direct
    }
  }

  function renderRoster(){
    const cs = DATA.candidats || [];
    if(!coefSet()){
      $('roster').innerHTML = '<div class="em-alert em-alert--warning"><span class="em-alert-icon"><svg class="ico"><use href="#i-hourglass"/></svg></span><div class="em-alert-body"><span class="em-alert-text">Posez d\'abord les coefficients ci-dessus.</span></div></div>';
      $('savebar').hidden = true; return;
    }
    if(!cs.length){ $('roster').innerHTML = '<div class="card"><div class="card-body">Aucun convoqué pour cette session.</div></div>'; $('savebar').hidden = true; return; }
    let h = '<div class="em-table-wrap"><table class="em-table"><thead><tr><th>N°</th><th>Nom et prénoms</th>' +
      SUBJECTS.map(s => '<th style="text-align:center">' + esc(s.label) + '<br><span style="font-weight:400;text-transform:none">/20</span></th>').join('') +
      '<th>Absent</th><th>Moyenne / signal</th></tr></thead><tbody>';
    cs.forEach((c, i) => {
      const v = c.valeurs || {};
      h += '<tr class="nt-row' + (c.absent ? ' is-abs' : '') + '" data-id="' + esc(c.dossier_id) + '" data-nom="' + esc(c.nom) + '">' +
        '<td>' + esc(c.numero_convocation || '—') + '</td>' +
        /* C7 (DEC-J) : sur une ligne VALIDÉE, le seul geste est « Invalider » (Responsable) —
           l'écran promettait déjà le verrou, le serveur le tient désormais. */
        '<td>' + esc(c.nom) + (c.validees ? ' <span class="em-badge em-badge--success em-badge--sm">validées</span>' +
          (CANVALIDATE ? ' <button type="button" class="em-btn em-btn--ghost em-btn--sm" data-inv="' + esc(c.dossier_id) + '" data-nom="' + esc(c.nom) + '">Invalider</button>' : '') : '') + '</td>' +
        /* C2 : type="text" inputmode="decimal" — PAS type="number" : sous Chrome, « 12,5 » y est
           rejeté par le navigateur → value="" → perte SILENCIEUSE (variante du mal NT-01). Le
           clavier numérique mobile est conservé ; la plage reste jugée par noteError (A10).
           C1 (DEC-H) : une ligne ABSENTE naît avec ses cellules réellement disabled (pas
           seulement pointer-events:none — Tab n'y entre plus). */
        SUBJECTS.map(s => '<td style="text-align:center"><input class="nt-in" type="text" inputmode="decimal" data-k="' + esc(s.key) + '" value="' +
          (v[s.key] != null ? esc(String(v[s.key])) : '') + '"' + ((c.validees || c.absent) ? ' disabled' : '') + '></td>').join('') +
        '<td><label class="nt-abs"><input type="checkbox" class="nt-absck"' + (c.absent ? ' checked' : '') + (c.validees ? ' disabled' : '') + '> absent</label></td>' +
        '<td>' + moyCell(c) + '</td></tr>';
    });
    h += '</tbody></table></div>';
    $('roster').innerHTML = h;
    $('savebar').hidden = false;
    $('btn-validate').hidden = !(CANVALIDATE && cs.length);
    const inputs = Array.from($('roster').querySelectorAll('input.nt-in'));
    inputs.forEach((inp, i) => {
      inp.addEventListener('input', validateRoster);
      inp.addEventListener('keydown', e => {
        /* C10 (patron Single view) : Entrée = MÊME COLONNE, ligne suivante — la saisie en salle
           descend une colonne d'épreuve. La liste est en ordre ligne-major → +SUBJECTS.length.
           Tab traverse la ligne (ordre DOM natif, rien à câbler). */
        if(e.key === 'Enter'){
          e.preventDefault();
          let j = i + SUBJECTS.length;
          while(inputs[j] && inputs[j].disabled) j += SUBJECTS.length;   // saute absents/validées
          (inputs[j] || $('btn-save')).focus();
        }
      });
    });
    /* C1 (DEC-H) : plus AUCUN chemin où des notes tapées partent à la poubelle en silence.
       4 chemins : sans notes → désactivation directe · avec notes → CONFIRMATION (annulée =
       coche annulée, notes intactes) · décoché → cellules réactivées, vides. */
    $('roster').querySelectorAll('.nt-absck').forEach(ck => ck.addEventListener('change', e => {
      const tr = e.target.closest('.nt-row');
      const cells = Array.from(tr.querySelectorAll('input.nt-in'));
      const markAbsent = () => {
        cells.forEach(inp => { inp.value = ''; inp.disabled = true; inp.classList.remove('nt-invalid'); inp.removeAttribute('title'); });
        e.target.checked = true;
        tr.classList.add('is-abs');
        validateRoster();
      };
      if(e.target.checked){
        const filled = cells.filter(inp => inp.value.trim() !== '');
        if(!filled.length){ markAbsent(); return; }
        e.target.checked = false;   // état inchangé tant que non confirmé (annuler = ne rien perdre)
        UI.emModal({
          title: 'Marquer absent(e)',
          lead: 'Effacer les ' + filled.length + ' note(s) saisie(s) de ' + (tr.dataset.nom || tr.dataset.id) +
                ' ? Un(e) absent(e) n\'a ni notes ni moyenne.',
          fields: [], submitLabel: 'Effacer et marquer absent(e)', danger: true,
          onSubmit: async () => { markAbsent(); }
        });
      } else {
        cells.forEach(inp => { inp.disabled = false; inp.value = ''; });
        tr.classList.remove('is-abs');
        validateRoster();
      }
    }));
    validateRoster();
  }

  function noteError(inp){
    const v = inp.value.trim();
    if(v === '') return null;
    const n = Number(v.replace(',', '.'));
    if(!isFinite(n) || n < 0 || n > 20){
      return { label: (SUBJECTS.find(s => s.key === inp.dataset.k) || {}).label || inp.dataset.k, value: v };
    }
    return null;
  }

  // A10 — validation IMMÉDIATE : champ hors 0-20 signalé à la frappe, épreuve + valeur nommées,
  // bouton d'enregistrement inopérant tant qu'une anomalie subsiste. (La garde serveur reste la
  // protection réelle ; ceci évite d'y arriver.)
  function validateRoster(){
    const errs = [];
    $('roster').querySelectorAll('.nt-row').forEach(tr => {
      const abs = tr.classList.contains('is-abs');
      tr.querySelectorAll('input.nt-in').forEach(inp => {
        const e = abs ? null : noteError(inp);
        inp.classList.toggle('nt-invalid', !!e);
        if(e){
          inp.title = e.label + ' : ' + e.value + ' — la note doit être comprise entre 0 et 20';
          errs.push({ nom: tr.dataset.nom || tr.dataset.id, label: e.label, value: e.value });
        } else { inp.removeAttribute('title'); }
      });
    });
    $('nt-errors').innerHTML = errs.length
      ? '<div class="em-alert em-alert--warning" style="margin-top:var(--space-4)"><span class="em-alert-icon"><svg class="ico"><use href="#i-warning"/></svg></span>' +
        '<div class="em-alert-body"><span class="em-alert-text"><b>' + errs.length + ' note(s) hors barème (0–20)</b> — corrigez avant d\'enregistrer :</span>' +
        '<ul class="imp-probs">' + errs.map(e => '<li>' + esc(e.nom + ' · ' + e.label + ' : ' + e.value + ' — la note doit être comprise entre 0 et 20') + '</li>').join('') + '</ul></div></div>'
      : '';
    $('btn-save').disabled = errs.length > 0;
    return errs.length === 0;
  }

  async function validateSession(){
    let prev;
    try { prev = await API.notesValiderMassePreview(SESSION); }
    catch(e){ UI.emToast(e.message, 'error'); return; }
    if(!prev.a_valider){ UI.emToast('Aucune note en attente de validation dans cette session.', 'error'); return; }
    UI.emModal({
      title: 'Valider les notes de la session',
      lead: 'Vous allez valider ' + prev.a_valider + ' dossier(s), dont ' + prev.avec_signal +
            ' portant un signal éliminatoire. Cette validation confirme les notes — elle ne décide pas l\'admission.',
      fields: [],
      submitLabel: 'Valider ' + prev.a_valider + ' dossier(s)',
      onSubmit: async () => {
        const res = await API.notesValiderMasse(SESSION);
        UI.emToast(res.valides + ' dossier(s) validé(s)' + (res.avec_signal ? ', dont ' + res.avec_signal + ' à signal éliminatoire.' : '.'), 'success');
        await load(SESSION);
      }
    });
  }

  function collectRows(){
    const rows = [];
    $('roster').querySelectorAll('.nt-row').forEach(tr => {
      const first = tr.querySelector('.nt-in');
      if(first && first.disabled) return;              // déjà validées : intactes
      const abs = tr.querySelector('.nt-absck').checked;
      const row = { dossier_id: tr.dataset.id };
      if(abs){ row.absent = '1'; rows.push(row); return; }
      let any = false;
      /* C2 : normalisation « , » → « . » à l'ENVOI — le serveur fait float(), « 12,5 » y
         échouerait ; l'écran accepte la virgule française, le contrat parle en point. */
      tr.querySelectorAll('input.nt-in').forEach(inp => { if(inp.value.trim() !== ''){ row[inp.dataset.k] = inp.value.trim().replace(',', '.'); any = true; } });
      if(any) rows.push(row);                          // ligne vide → ignorée
    });
    return rows;
  }

  /* C5 : chaque anomalie s'affiche « Ligne N · nom — motif » — le n° de ligne (TOUJOURS servi
     par le back sur les anomalies d'import) prime ; `reference` (« ? ») ne s'affiche plus jamais.
     Les anomalies d'ÉCRITURE (post-aperçu) n'ont pas de ligne → nom/dossier. */
  function probLine(p){
    const who = p.ligne != null
      ? 'Ligne ' + p.ligne + (p.nom ? ' · ' + p.nom : '')
      : (p.nom || p.dossier_id || 'Dossier');
    return who + ' — ' + p.probleme;
  }

  function reportResult(res){
    const probs = res.problemes || [];
    $('save-result').innerHTML = probs.length
      ? '<div class="em-alert em-alert--warning" style="margin-top:var(--space-5)"><span class="em-alert-icon"><svg class="ico"><use href="#i-warning"/></svg></span><div class="em-alert-body"><span class="em-alert-text"><b>' + res.ecrits + '</b> enregistré(s), <b>' + probs.length + '</b> non écrit(s) :</span><ul class="imp-probs">' +
        probs.map(p => '<li>' + esc(probLine(p)) + '</li>').join('') + '</ul></div></div>'
      : '';
    UI.emToast(res.ecrits + ' candidat(s) enregistré(s)' + (probs.length ? ', ' + probs.length + ' anomalie(s).' : '.'), probs.length ? 'error' : 'success');
  }

  /* DEC-I : un message GLOBAL actionnable (fichier corrompu) mérite un BANDEAU PERSISTANT —
     un toast fugace disparaît avant d'être lu. Les autres erreurs restent en toast. */
  function showImportError(err){
    if(err && err.code === 'CSV_MOJIBAKE'){
      $('imp-host').innerHTML =
        '<div class="em-alert em-alert--error" style="margin-bottom:var(--space-5)"><span class="em-alert-icon"><svg class="ico"><use href="#i-warning"/></svg></span>' +
        '<div class="em-alert-body"><div class="em-alert-title">Fichier rejeté</div><span class="em-alert-text">' + esc(err.message) + '</span></div></div>';
    } else {
      UI.emToast(err && err.message ? err.message : 'Import impossible.', 'error');
    }
  }

  async function save(){
    if(!validateRoster()){ UI.emToast('Des notes sont hors barème (0–20) — corrigez-les d\'abord.', 'error'); return; }
    const rows = collectRows();
    if(!rows.length){ UI.emToast('Aucune note à enregistrer.', 'error'); return; }
    try { const res = await API.notesSaisirMasse(SESSION, rows); reportResult(res); await load(SESSION); }
    catch(e){ UI.emToast(e.message, 'error'); }
  }

  async function doExport(){
    try {
      const r = await API.notesExport(SESSION);
      const blob = new Blob([r.csv], { type: 'text/csv;charset=utf-8' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob); a.download = r.filename || 'notes.csv';
      document.body.appendChild(a); a.click(); a.remove(); URL.revokeObjectURL(a.href);
    } catch(e){ UI.emToast(e.message, 'error'); }
  }

  /* ── C9 (FIX-3) : ASSISTANT d'import — nos fichiers passent DIRECT ; l'étape de mapping
     n'apparaît qu'en cas d'écart d'en-têtes, le repli d'encodage seulement si la lecture
     échoue réellement (caractères �). Le PARSING reste serveur (source unique FIX-0) : le
     front ne réécrit que la LIGNE D'EN-TÊTE mappée, même séparateur. ── */
  let IMPFILE = null, IMPENC = 'utf-8';
  const _normH = h => String(h || '').replace(/^﻿/, '').trim().replace(/^="?|"?$/g, '').toLowerCase();
  function _targets(){
    const t = [{ v: '', l: '— ignorer —' }, { v: 'dossier_id', l: 'dossier_id' },
               { v: 'numero_convocation', l: 'n° de convocation' }, { v: 'nom', l: 'nom' }];
    SUBJECTS.forEach(s => t.push({ v: s.key, l: s.label }));
    t.push({ v: 'absent', l: 'absent' });
    return t;
  }
  function _guessTarget(h){
    const n = _normH(h);
    const known = { 'dossier_id': 'dossier_id', 'numero_convocation': 'numero_convocation',
                    'numero': 'numero_convocation', 'nom': 'nom', 'absent': 'absent' };
    if(known[n]) return known[n];
    const bySubj = SUBJECTS.find(s => n === s.key || n === s.label.toLowerCase());
    if(bySubj) return bySubj.key;
    if(n.includes('dossier')) return 'dossier_id';
    if(n.includes('convoc') || n.includes('numero') || n.includes('n°')) return 'numero_convocation';
    if(n.includes('math')) return 'maths';
    if(n.includes('phys')) return 'physique';
    if(n.includes('cult')) return 'culture';
    if(n.includes('abs')) return 'absent';
    if(n.includes('nom') || n.includes('candidat')) return 'nom';
    return '';
  }
  function _analyze(csv){
    const first = csv.replace(/^﻿/, '').split(/\r?\n/)[0] || '';
    const sep = first.split(';').length > first.split(',').length ? ';' : ',';
    const headers = first.split(sep);
    const unknown = headers.filter(h => !_guessTarget(h) || (_normH(h) !== _guessTarget(h)
      && !(SUBJECTS.find(s => s.key === _guessTarget(h) && s.label.toLowerCase() === _normH(h)))
      && !(_normH(h) === 'numero' && _guessTarget(h) === 'numero_convocation')));
    return { sep, headers, exact: headers.every(h => {
      const n = _normH(h);
      return n === 'dossier_id' || n === 'numero_convocation' || n === 'numero' || n === 'nom'
        || n === 'absent' || SUBJECTS.some(s => n === s.key || n === s.label.toLowerCase());
    }) };
  }
  function onImportFile(e){
    IMPFILE = e.target.files[0]; e.target.value = '';
    if(IMPFILE){ IMPENC = 'utf-8'; readImport(); }
  }
  function readImport(){
    const rd = new FileReader();
    rd.onload = () => handleCsvText(String(rd.result));
    rd.readAsText(IMPFILE, IMPENC);
  }
  async function handleCsvText(csv){
    if(IMPENC === 'utf-8' && csv.indexOf('�') !== -1){ renderReadOptions(); return; }
    const a = _analyze(csv);
    if(!a.exact){ renderMapping(csv, a); return; }
    await runPreview(csv);
  }
  async function runPreview(csv){
    try { const prev = await API.notesImportPreview(SESSION, csv); showPreview(csv, prev); }
    catch(err){ showImportError(err); }
  }
  /* Repli ENCODAGE : uniquement quand la lecture UTF-8 produit des � (fichier legacy). */
  function renderReadOptions(){
    $('imp-host').innerHTML =
      '<div class="card" style="margin-bottom:var(--space-5)"><div class="card-head"><div class="card-title">Lecture du fichier</div></div><div class="card-body">' +
      '<p>Des caractères illisibles (�) : ce fichier n\'est pas en UTF-8. Choisissez son encodage :</p>' +
      '<div style="display:flex;gap:var(--space-3);align-items:center;margin-top:var(--space-3)">' +
      '<select class="nt-sel" id="imp-enc" style="width:auto"><option value="windows-1252">Windows-1252 (Excel Windows)</option><option value="macintosh">MacRoman (Excel Mac ancien)</option></select>' +
      '<button type="button" class="em-btn em-btn--primary em-btn--sm" id="imp-reread">Relire le fichier</button>' +
      '<button type="button" class="em-btn em-btn--ghost em-btn--sm" id="imp-cancel2">Annuler</button></div></div></div>';
    $('imp-reread').addEventListener('click', () => { IMPENC = $('imp-enc').value; readImport(); });
    $('imp-cancel2').addEventListener('click', () => { $('imp-host').innerHTML = ''; });
  }
  /* Étape MAPPING : seulement si les en-têtes s'écartent — propositions automatiques. */
  function renderMapping(csv, a){
    const opts = _targets();
    $('imp-host').innerHTML =
      '<div class="card" style="margin-bottom:var(--space-5)"><div class="card-head"><div class="card-title">Correspondance des colonnes</div></div><div class="card-body">' +
      '<p>Les en-têtes du fichier ne correspondent pas exactement au gabarit — vérifiez la correspondance proposée :</p>' +
      '<div style="display:grid;grid-template-columns:auto auto;gap:var(--space-2) var(--space-5);align-items:center;margin:var(--space-4) 0;max-width:560px">' +
      a.headers.map((h, i) =>
        '<span style="font-family:var(--font-mono);font-size:var(--text-xs)">' + esc(_normH(h) || '(vide)') + '</span>' +
        '<select class="nt-sel imp-map" data-i="' + i + '" style="width:auto">' +
        opts.map(o => '<option value="' + o.v + '"' + (o.v === _guessTarget(h) ? ' selected' : '') + '>' + esc(o.l) + '</option>').join('') +
        '</select>').join('') +
      '</div><div style="display:flex;gap:var(--space-3)">' +
      '<button type="button" class="em-btn em-btn--primary em-btn--sm" id="imp-map-go">Appliquer et prévisualiser</button>' +
      '<button type="button" class="em-btn em-btn--ghost em-btn--sm" id="imp-map-cancel">Annuler</button></div></div></div>';
    $('imp-map-go').addEventListener('click', async () => {
      const chosen = Array.from(document.querySelectorAll('.imp-map')).map(s => s.value);
      const lines = csv.replace(/^﻿/, '').split(/\r?\n/);
      /* réécrit UNIQUEMENT l'en-tête (même séparateur) — le corps et le parse restent serveur */
      lines[0] = a.headers.map((h, i) => chosen[i] || ('ignore_' + i)).join(a.sep);
      await runPreview(lines.join('\r\n'));
    });
    $('imp-map-cancel').addEventListener('click', () => { $('imp-host').innerHTML = ''; });
  }

  function showPreview(csv, prev){
    const probs = prev.problemes || [];
    let h = '<div class="card" style="margin-bottom:var(--space-5)"><div class="card-head"><div class="card-title">Aperçu de l\'import</div></div><div class="card-body">' +
      '<p><b>' + prev.compte_a_ecrire + '</b> candidat(s) seront enregistrés' + (probs.length ? ', <b>' + probs.length + '</b> ligne(s) en anomalie (non écrites) :' : '.') + '</p>';
    if(probs.length) h += '<ul class="imp-probs">' + probs.map(p => '<li>' + esc(probLine(p)) + '</li>').join('') + '</ul>';
    // C5 : à 0 importable, le bouton reste inerte — un texte dit QUOI FAIRE au lieu d'une impasse
    if(!prev.compte_a_ecrire) h += '<p style="color:var(--text-secondary);font-size:var(--text-sm)">Aucune ligne importable — corrigez les anomalies ci-dessus ou vérifiez le fichier (séparateur, en-têtes, identifiants), puis réimportez.</p>';
    h += '<div style="display:flex;gap:var(--space-3);margin-top:var(--space-4)">' +
      '<button type="button" class="em-btn em-btn--primary em-btn--sm" id="imp-go"' + (prev.compte_a_ecrire ? '' : ' disabled') + '>Écrire ' + prev.compte_a_ecrire + ' candidat(s)</button>' +
      '<button type="button" class="em-btn em-btn--ghost em-btn--sm" id="imp-cancel">Annuler</button></div></div></div>';
    $('imp-host').innerHTML = h;
    $('imp-go').addEventListener('click', async () => {
      try { const res = await API.notesCommitCsv(SESSION, csv); $('imp-host').innerHTML = ''; reportResult(res); await load(SESSION); }
      catch(e){ showImportError(e); }
    });
    $('imp-cancel').addEventListener('click', () => { $('imp-host').innerHTML = ''; });
  }

  /* C8 (FIX-3) : consultation du journal (DEC-J) — lecture par l'API resource générique,
     DocPerms lecture du doctype (READ_UP) ; aucun endpoint dédié, le doctype EST le contrat. */
  function champLabel(){
    const m = { absent: 'Absent', validation: 'Validation' };
    SUBJECTS.forEach(s => { m[s.key] = s.label; });
    return m;
  }
  async function loadHistorique(){
    if(!SESSION) return;
    const flt = { session: SESSION };
    if($('hist-flt').value) flt.applicant = $('hist-flt').value;
    try {
      const rows = await API.resource('Admission Note Change Log',
        ['applicant', 'applicant_name', 'champ', 'old_value', 'new_value', 'action_type', 'origin', 'author', 'at'],
        flt, 'at desc');
      const m = champLabel();
      const dash = v => (v === '' || v == null) ? '—' : String(v);
      $('hist-body').innerHTML = (rows && rows.length)
        ? '<div class="em-table-wrap"><table class="em-table"><thead><tr><th>Quand</th><th>Candidat</th><th>Champ</th><th>Ancienne → nouvelle</th><th>Acte · origine</th><th>Par</th></tr></thead><tbody>' +
          rows.map(r => '<tr><td>' + esc(String(r.at || '').slice(0, 16)) + '</td><td>' + esc(r.applicant_name || r.applicant) + '</td>' +
            '<td>' + esc(m[r.champ] || r.champ) + '</td><td>' + esc(dash(r.old_value) + ' → ' + dash(r.new_value)) + '</td>' +
            '<td>' + esc((r.action_type || '') + ' · ' + (r.origin || '')) + '</td><td>' + esc(r.author || '') + '</td></tr>').join('') +
          '</tbody></table></div>'
        : '<p style="color:var(--text-secondary)">Aucune modification enregistrée pour cette session.</p>';
    } catch(e){ $('hist-body').innerHTML = '<p style="color:var(--text-secondary)">' + esc(e.message) + '</p>'; }
  }

  async function load(session){
    SESSION = session;
    COEF_EDITING = false;
    ['imp-host', 'save-result', 'roster', 'hist-body'].forEach(id => $(id).innerHTML = '');
    $('coef-card').hidden = true; $('savebar').hidden = true; $('signal-note').hidden = true;
    $('btn-export').hidden = true; $('btn-import-l').hidden = true; $('hist-card').hidden = true;
    if(!session){ $('sub').textContent = 'Choisissez une session à concours.'; return; }
    try {
      DATA = await API.notesRoster(session);
      SUBJECTS = (DATA.subjects && DATA.subjects.subjects) || [];
      $('sub').textContent = (DATA.candidats || []).length + ' convoqué(s) · ordre de la feuille d\'émargement';
      $('btn-export').hidden = false;
      $('btn-import-l').hidden = !coefSet();
      renderCoef();
      renderRoster();
      $('hist-card').hidden = false;
      $('hist-flt').innerHTML = '<option value="">Tous</option>' + (DATA.candidats || []).map(c =>
        '<option value="' + esc(c.dossier_id) + '">' + esc(c.nom) + '</option>').join('');
      loadHistorique();
    } catch(e){ $('roster').innerHTML = '<div class="card"><div class="card-body">' + esc(e.message) + '</div></div>'; }
  }

  async function init(){
    let me;
    try { me = await API.whoami(); }
    catch(e){
      if(e.code==='AUTH') return;   // non authentifié → redirection gérée par request()
      // OBS-1 E-07 : ne PAS rester inerte en silence si la détection du rôle échoue. L'écran restait
      // vide sans explication ; on affiche un message actionnable et on journalise (console.error).
      console.error('whoami a échoué à l’initialisation de /notes', e);
      $('roster').innerHTML = '<div class="card"><div class="card-body">' +
        esc((e.message || 'Impossible de vérifier votre profil.') + ' Rechargez la page ou reconnectez-vous.') +
        '</div></div>';
      return;
    }
    const ux = API.uxRole(me.roles || []);
    CANSETCOEF = ['resp', 'dir', 'sm'].includes(ux);
    CANVALIDATE = ['resp', 'sm'].includes(ux);   // Responsable EXACT — Direction exclue (requirement 1)
    $('btn-export').addEventListener('click', doExport);
    $('file-import').addEventListener('change', onImportFile);
    /* C7 (DEC-J) : invalidation = acte EXPLICITE, confirmation NOMMÉE, journalisé serveur */
    $('roster').addEventListener('click', e => {
      const b = e.target.closest('[data-inv]'); if(!b) return;
      UI.emModal({
        title: 'Invalider les notes',
        lead: 'Invalider les notes validées de ' + b.dataset.nom + ' ? La saisie sera rouverte ' +
              'et l\'acte journalisé (auteur, horodatage).',
        fields: [], submitLabel: 'Invalider les notes', danger: true,
        onSubmit: async () => {
          await API.notesInvalider(b.dataset.inv);
          UI.emToast('Notes invalidées — saisie rouverte.', 'success');
          await load(SESSION);
        }
      });
    });
    $('btn-save').addEventListener('click', save);
    $('btn-validate').addEventListener('click', validateSession);
    $('hist-refresh').addEventListener('click', loadHistorique);
    $('hist-flt').addEventListener('change', loadHistorique);
    $('sess').addEventListener('change', e => load(e.target.value));
    try {
      const r = await API.notesPrepaSessions();
      $('sess').innerHTML = '<option value="">— choisir une session —</option>' + (r.sessions || []).map(s =>
        '<option value="' + esc(s.session_id) + '">' + esc(s.label + ' — ' + (s.programme_label || '') + (s.exam_date ? ' (' + API.fmtDate(s.exam_date) + ')' : '')) + '</option>').join('');
    } catch(e){ UI.emToast(e.message, 'error'); }
    const url = new URLSearchParams(location.search).get('session');
    if(url){ $('sess').value = url; if($('sess').value) load(url); }
  }
  init();
})();
</script>
</Layout>
