---
import '@emela/design-system/index.css';
import '../styles/shell.css';
import Icons from '../components/Icons.astro';
import pkg from '../../package.json';

interface Props {
  title: string;
  role?: 'admin' | 'resp' | 'dir' | 'sm';
  page?: string;
  shared?: boolean;
  prog?: string;
}
const { title, role = 'admin', page = '', shared = false, prog } = Astro.props;
const appVersion = pkg.version;
// C4-FRONT : base API configurable au build (recette/prod), défaut = site dev Frappe.
const apiBase = import.meta.env.PUBLIC_API_BASE || 'http://admission-dev.localhost:8000';

// STAFF-HEADER-NAV — SOURCE UNIQUE de navigation. Le header vit ICI (plus dupliqué par page) ;
// toute page héritant de Layout le porte. `is-active` dérivé de `page` (fini le codage en dur) ;
// visibilité par rôle via data-roles (câblée par shell.js). Ordre = ordre d'affichage.
const NAV = [
  { key: 'espace',       href: '/espace-administratif', label: 'Espace de traitement', icon: 'i-tray',    roles: 'admin' },
  { key: 'cockpit',      href: '/cockpit-responsable',  label: 'Cockpit',              icon: 'i-gauge',   roles: 'resp' },
  { key: 'tableau',      href: '/tableau-direction',    label: 'Tableau de bord',      icon: 'i-chart',   roles: 'dir' },
  { key: 'dossiers',     href: '/liste-dossiers',       label: 'Dossiers',             icon: 'i-folders' },
  { key: 'calendrier',   href: '/calendrier',           label: 'Calendrier',           icon: 'i-cal',     roles: 'resp dir' },
  { key: 'notes',        href: '/notes',                label: 'Notes',                icon: 'i-medal',   roles: 'admin resp dir' },
  { key: 'gestion',      href: '/gestion-sessions',     label: 'Sessions & frais',     icon: 'i-coins',   roles: 'dir' },
  { key: 'personnel',    href: '/personnel',            label: 'Personnel',            roles: 'sm' },
  { key: 'exploitation', href: '/exploitation',         label: 'Exploitation',         roles: 'sm' },
  { key: 'reglages',     href: '/reglages',             label: 'Réglages',             roles: 'sm' },
];
// La vue détail dossier appartient à la section « Dossiers » → on y active l'entrée Dossiers.
const activeNav = ({ dossier: 'dossiers' })[page] || page;

// Breadcrumb dérivé de `page` (source unique, pas codé en dur par page). Dernier segment =
// position courante (aria-current="page"). Le détail dossier a un segment DYNAMIQUE
// (#crumb-code, rempli au runtime par le JS de page — comportement préservé).
const CRUMBS = {
  espace:       [{ label: 'Espace de traitement' }],
  cockpit:      [{ label: 'Cockpit' }],
  tableau:      [{ label: 'Tableau de bord' }],
  dossiers:     [{ label: 'Dossiers' }],
  dossier:      [{ label: 'Dossiers', href: '/liste-dossiers' }, { label: '…', id: 'crumb-code', mono: true }],
  calendrier:   [{ label: 'Calendrier' }],
  notes:        [{ label: 'Saisie des notes' }],
  gestion:      [{ label: 'Sessions & frais' }],
  personnel:    [{ label: 'Personnel' }],
  exploitation: [{ label: 'Exploitation' }],
  reglages:     [{ label: 'Réglages' }],
};
const crumbs = CRUMBS[page] || [];
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" />
    <!-- STAFF-GATE : cloak anti-clignotement (pages protégées = celles qui héritent de Layout).
         Front STATIQUE (aucun adapter Astro) → la session est un appel réseau ASYNC : impossible de
         savoir avant de peindre. On MASQUE le body avant tout rendu ; shell.js tranche au boot :
           · session valide  → reveal() retire ce cloak (page dans son état final) ;
           · auth absente     → redirection /connexion, cloak MAINTENU → la structure ne s'affiche
                                JAMAIS, même une fraction de seconde (DEC-B, cœur du lot) ;
           · panne réseau     → carte « Réessayer », cloak maintenu (pas de déconnexion, DEC-F).
         VOLONTAIREMENT SANS FAILSAFE. N'AJOUTEZ PAS de « timeout de sécurité » qui révélerait la page
         tout seul : ce serait un CONTOURNEMENT du garde — il suffirait de bloquer shell.js pour voir
         la structure. Un garde qui s'ouvre seul n'est pas un garde. Si les scripts ne chargent pas,
         la page RESTE BLANCHE : panne visible, déjà remontée par OBS-1. C'est un choix, pas un oubli. -->
    <!-- is:inline OBLIGATOIRE : sans lui Astro SCOPE le style (body → body[data-astro-cid]) et
         l'extrait dans le bundle CSS externe → le cloak ne s'appliquerait jamais. Verbatim en head. -->
    <style is:inline id="auth-cloak">body{visibility:hidden!important}</style>
    <script is:inline define:vars={{ apiBase }}>window.EMELA_API_BASE = apiBase;</script>
    <!-- OBS-1 : capture d'erreur front AVANT api/ui/shell → attrape aussi un échec de chargement (ex. EmelaUI undefined). Silence défensif. -->
    <script is:inline>
      (function () {
        var n = 0, B = window.EMELA_API_BASE || '';
        function r(o) {
          if (n++ > 5 || !B) return;
          try {
            o.front = 'management'; o.page = location.pathname; o.ua = (navigator.userAgent || '').slice(0, 160);
            fetch(B + '/api/method/admission.api.health.log_client_error',
              { method: 'POST', headers: { 'Content-Type': 'application/json' }, keepalive: true, body: JSON.stringify(o) }
            ).catch(function () {});
          } catch (e) {}
        }
        addEventListener('error', function (e) { r({ message: String(e.message || '').slice(0, 300), source: String(e.filename || '').slice(0, 200), line: e.lineno, col: e.colno }); });
        addEventListener('unhandledrejection', function (e) { r({ message: ('reject: ' + String((e.reason && e.reason.message) || e.reason || '')).slice(0, 300) }); });
      })();
    </script>
    <!-- D-LAYOUT-SCRIPT-ORDER-19 : externes EN HEAD (avant le slot) → EmelaAPI/EmelaUI définis
         AVANT toute IIFE de page (sinon `window.EmelaUI` undefined → crash, back-office inopérant).
         Ordre api→ui→shell préservé ; EMELA_API_BASE reste avant api.js ; shell.js boote en
         DOMContentLoaded (aucun accès DOM au load). -->
    <!-- CAL-13 : ?v= casse le cache navigateur (asset public/ non hashé, max-age=43200) —
         BUMPER à chaque modification, dans le même commit. STAFF-GATE : api.js ?v=4→?v=5 (garde
         gotoLogin/safeNextPath) ; shell.js versionné ?v=1 (dette latente fermée — il était servi
         SANS paramètre, comme ui.js avant A11Y-1 ; bumper à toute modif désormais). -->
    <script is:inline src="/scripts/api.js?v=5"></script>
    <script is:inline src="/scripts/ui.js?v=1"></script>
    <script is:inline src="/scripts/shell.js?v=1"></script>
  </head>
  <body data-role={role} data-page={page} data-shared={shared ? '' : undefined} data-prog={prog}>
    <Icons />
    <a href="#main-content" class="skip-link">Aller au contenu</a>

    <!-- STAFF-HEADER-NAV : header PARTAGÉ (source unique). shell.js remplit l'identité (.app-user),
         gère la visibilité par rôle (data-roles) et la déconnexion. -->
    <header class="app-top">
      <div class="app-top-inner">
        <a class="brand" href="/" data-home aria-label="Accueil"><img src="/lanem-logo.webp" alt="LaNEM" style="height:36px;width:auto;display:block" /></a>
        <nav class="nav" aria-label="Navigation principale">
          {NAV.map((item) => (
            <a
              href={item.href}
              data-roles={item.roles}
              class:list={[item.key === activeNav && 'is-active']}
              aria-current={item.key === page ? 'page' : undefined}
            >
              {item.icon && <svg class="ico-sm" aria-hidden="true" focusable="false"><use href={`#${item.icon}`} /></svg>}{item.label}
            </a>
          ))}
        </nav>
        <div class="app-user">
          <div class="meta"><div class="nm">—</div><div class="rl">—</div></div>
          <div class="av">·</div>
        </div>
      </div>
    </header>

    {crumbs.length > 1 && (
      <nav class="crumbwrap" aria-label="Fil d'Ariane">
        <ol class="crumb">
          {crumbs.map((c, i) => (
            <li aria-current={i === crumbs.length - 1 ? 'page' : undefined}>
              {c.href && i < crumbs.length - 1
                ? <a href={c.href}>{c.label}</a>
                : <span id={c.id} class:list={[c.mono && 'crumb-mono']}>{c.label}</span>}
            </li>
          ))}
        </ol>
      </nav>
    )}

    <slot />
    <footer class="version-stamp" aria-label="Version de l’application">Version {appVersion}</footer>
  </body>
</html>

<style>
  .version-stamp {
    padding: var(--space-4) var(--space-9);
    color: var(--text-tertiary);
    font-size: var(--text-xs);
    text-align: center;
  }
</style>
