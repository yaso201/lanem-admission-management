---
import '@emela/design-system/index.css';
import Icons from '../components/Icons.astro';
import pkg from '../../package.json';

interface Props { title: string; }
const { title } = Astro.props;
const appVersion = pkg.version;
const apiBase = import.meta.env.PUBLIC_API_BASE || 'http://admission-dev.localhost:8000';
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" />
    <script is:inline define:vars={{ apiBase }}>window.EMELA_API_BASE = apiBase;</script>
    <!-- OBS-1 : capture d'erreur front (remontée non-bloquante ; silence défensif). -->
    <script is:inline>
      (function () {
        var n = 0, B = window.EMELA_API_BASE || '';
        function r(o) {
          if (n++ > 5 || !B) return;
          try {
            o.front = 'management'; o.page = location.pathname; o.ua = (navigator.userAgent || '').slice(0, 160);
            fetch(B + '/api/method/admission.api.health.log_client_error',
              { method: 'POST', headers: { 'Content-Type': 'application/json' }, keepalive: true, body: JSON.stringify(o) }
            ).catch(function () {});
          } catch (e) {}
        }
        addEventListener('error', function (e) { r({ message: String(e.message || '').slice(0, 300), source: String(e.filename || '').slice(0, 200), line: e.lineno, col: e.colno }); });
        addEventListener('unhandledrejection', function (e) { r({ message: ('reject: ' + String((e.reason && e.reason.message) || e.reason || '')).slice(0, 300) }); });
      })();
    </script>
  </head>
  <body>
    <Icons />
    <slot />
    <footer class="version-stamp" aria-label="Version de l’application">Version {appVersion}</footer>
    <script is:inline src="/scripts/api.js?v=3"></script>
    <script is:inline src="/scripts/ui.js?v=1"></script>
  </body>
</html>

<style>
  .version-stamp {
    padding: var(--space-4) var(--space-6);
    color: var(--text-tertiary);
    font-size: var(--text-xs);
    text-align: center;
  }
</style>
